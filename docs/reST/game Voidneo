    # ========================================
    # Enemy Logic
    # ========================================
    if not game_over:

        for enemy in enemies:

            # Move Enemy
            enemy.y += enemy_speed

            # Draw Enemy
            pygame.draw.rect(screen, RED, enemy)

            # Reset Enemy
            if enemy.y > HEIGHT:

                enemy.x = random.randint(0, WIDTH - enemy_size)
                enemy.y = random.randint(-150, -50)

                score += 1

            # Collision Detection
            if player_rect.colliderect(enemy):
                game_over = True

    else:

        # Draw enemies even after game over
        for enemy in enemies:
            pygame.draw.rect(screen, RED, enemy)

    # ========================================
    # Draw Score
    # ========================================
    score_text = font.render(
        f"Score: {score}",
        True,
        YELLOW
    )

    screen.blit(score_text, (20, 20))

    # ========================================
    # Game Over Screen
    # ========================================
    if game_over:

        game_over_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        restart_text = font.render(
            "Press R to Restart",
            True,
            WHITE
        )

        screen.blit(
            game_over_text,
            (
                WIDTH // 2 - game_over_text.get_width() // 2,
                HEIGHT // 2 - 80
            )
        )

        screen.blit(
            restart_text,
            (
                WIDTH // 2 - restart_text.get_width() // 2,
                HEIGHT // 2 + 20
            )
        )

        # Restart Game
        if keys[pygame.K_r]:

            player_x = WIDTH // 2
            player_y = HEIGHT - 80

            enemies.clear()

            for i in range(5):
                create_enemy()

            score = 0
            game_over = False

    # ========================================
    # Update Screen
    # ========================================
    pygame.display.update()

    # ========================================
    # FPS Control
    # ========================================
    clock.tick(FPS)

# ============================================
# Quit Pygame
# ============================================
pygame.quit()
sys.exit()
