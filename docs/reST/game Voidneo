import pygame
import sys
import random

# ============================================
# Initialize Pygame
# ============================================
pygame.init()

# ============================================
# Screen Settings
# ============================================
WIDTH = 800
HEIGHT = 600

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Space Dodge Game")

# ============================================
# Colors
# ============================================
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
BLUE = (50, 120, 255)
RED = (255, 60, 60)
GREEN = (50, 200, 100)
YELLOW = (255, 220, 0)

# ============================================
# Fonts
# ============================================
font = pygame.font.SysFont("Arial", 32)
big_font = pygame.font.SysFont("Arial", 72)

# ============================================
# Clock
# ============================================
clock = pygame.time.Clock()
FPS = 60

# ============================================
# Player Settings
# ============================================
player_size = 50
player_x = WIDTH // 2
player_y = HEIGHT - 80
player_speed = 7

# ============================================
# Enemy Settings
# ============================================
enemy_size = 50
enemy_speed = 6

enemies = []

# ============================================
# Game Variables
# ============================================
score = 0
game_over = False

# ============================================
# Create Enemy Function
# ============================================
def create_enemy():
    enemy_x = random.randint(0, WIDTH - enemy_size)
    enemy_y = random.randint(-150, -50)

    enemy = pygame.Rect(
        enemy_x,
        enemy_y,
        enemy_size,
        enemy_size
    )

    enemies.append(enemy)

# ============================================
# Spawn Initial Enemies
# ============================================
for i in range(5):
    create_enemy()

# ============================================
# Main Game Loop
# ============================================
running = True

while running:

    # ========================================
    # Event Handling
    # ========================================
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

    # ========================================
    # Player Movement
    # ========================================
    keys = pygame.key.get_pressed()

    if not game_over:

        if keys[pygame.K_LEFT]:
            player_x -= player_speed

        if keys[pygame.K_RIGHT]:
            player_x += player_speed

        if keys[pygame.K_UP]:
            player_y -= player_speed

        if keys[pygame.K_DOWN]:
            player_y += player_speed

    # ========================================
    # Keep Player Inside Screen
    # ========================================
    if player_x < 0:
        player_x = 0

    if player_x > WIDTH - player_size:
        player_x = WIDTH - player_size

    if player_y < 0:
        player_y = 0

    if player_y > HEIGHT - player_size:
        player_y = HEIGHT - player_size

    # ========================================
    # Background
    # ========================================
    screen.fill(BLACK)

    # ========================================
    # Draw Stars
    # ========================================
    for i in range(50):
        x = random.randint(0, WIDTH)
        y = random.randint(0, HEIGHT)

        pygame.draw.circle(screen, WHITE, (x, y), 1)

    # ========================================
    # Player Rectangle
    # ========================================
    player_rect = pygame.Rect(
        player_x,
        player_y,
        player_size,
        player_size
    )

    # ========================================
    # Draw Player
    # ========================================
    pygame.draw.rect(screen, BLUE, player_rect)

    # ========================================
    # Enemy Logic
    # ========================================
    if not game_over:

        for enemy in enemies:

            # Move Enemy
            enemy.y += enemy_speed

            # Draw Enemy
            pygame.draw.rect(screen, RED, enemy)

            # Reset Enemy
            if enemy.y > HEIGHT:

                enemy.x = random.randint(0, WIDTH - enemy_size)
                enemy.y = random.randint(-150, -50)

                score += 1

            # Collision Detection
            if player_rect.colliderect(enemy):
                game_over = True

    else:

        # Draw enemies even after game over
        for enemy in enemies:
            pygame.draw.rect(screen, RED, enemy)

    # ========================================
    # Draw Score
    # ========================================
    score_text = font.render(
        f"Score: {score}",
        True,
        YELLOW
    )

    screen.blit(score_text, (20, 20))

    # ========================================
    # Game Over Screen
    # ========================================
    if game_over:

        game_over_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        restart_text = font.render(
            "Press R to Restart",
            True,
            WHITE
        )

        screen.blit(
            game_over_text,
            (
                WIDTH // 2 - game_over_text.get_width() // 2,
                HEIGHT // 2 - 80
            )
        )

        screen.blit(
            restart_text,
            (
                WIDTH // 2 - restart_text.get_width() // 2,
                HEIGHT // 2 + 20
            )
        )

        # Restart Game
        if keys[pygame.K_r]:

            player_x = WIDTH // 2
            player_y = HEIGHT - 80

            enemies.clear()

            for i in range(5):
                create_enemy()

            score = 0
            game_over = False

    # ========================================
    # Update Screen
    # ========================================
    pygame.display.update()

    # ========================================
    # FPS Control
    # ========================================
    clock.tick(FPS)

# ============================================
# Quit Pygame
# ============================================
pygame.quit()
